#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output="${1:-$root/runtime/x86_64-linux/dfrotz}"
image="gcc:14.2.0-bookworm@sha256:82549aa8f90ada3236a8be70c74543132a76662ef33f0c3271ed802b81584a82"
build_root="$(mktemp -d "$root/.build-frotz.XXXXXX")"
trap 'rm -rf "$build_root"' EXIT
tar -xzf "$root/third_party/frotz/source/frotz-2.55.tar.gz" -C "$build_root" --strip-components=1
patch --quiet --directory "$build_root" --strip=0 < "$root/third_party/frotz/lantern-room-events.patch"
docker run --rm --platform linux/amd64 --user "$(id -u):$(id -g)" \
  --volume "$build_root:/src" --workdir /src --env SOURCE_DATE_EPOCH=0 "$image" \
  make PREFIX=/usr dumb \
    CFLAGS='-std=gnu99 -O2 -Wall -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE' \
    LDFLAGS='-pie -Wl,--build-id=none,-z,relro,-z,now -s'
mkdir -p "$(dirname "$output")"
output_dir="$(cd "$(dirname "$output")" && pwd)"
temporary="$output_dir/.$(basename "$output").tmp.$$"
trap 'rm -rf "$build_root"; rm -f "$temporary"' EXIT
install -m 0755 "$build_root/dfrotz" "$temporary"
mv -f "$temporary" "$output"
