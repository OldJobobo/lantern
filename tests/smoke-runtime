#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$root/runtime/x86_64-linux/dfrotz"
saves="$(mktemp -d)"
trap 'rm -rf "$saves"' EXIT

smoke_story() {
  local story="$1"
  local expected_title="$2"
  local expected_room="$3"
  local output

  output="$(printf 'look\nquit\ny\n' | timeout 10 "$runtime" -q -m -w 76 -R "$saves" "$root/games/$story")"
  grep -Fq "$expected_title" <<<"$output"
  grep -Fq "$expected_room" <<<"$output"
}

smoke_story "zork1.z3" "ZORK I: The Great Underground Empire" "West of House"
smoke_story "zork2.z3" "ZORK II: The Wizard of Frobozz" "Inside the Barrow"
smoke_story "zork3.z3" "ZORK III: The Dungeon Master" "Endless Stair"

printf 'Bundled dfrotz and Zork trilogy smoke passed.\n'
