@@ -492,6 +492,25 @@
 	if ((read_line_buffer[0] == '\r') && (read_line_buffer[1] == '\0'))
 		read_line_buffer[0] = '\0';
 
+	/* Lantern modification: report the actual completed VM input, not file
+	 * dialogs or a client-side prediction. Hex keeps record framing intact. */
+	const char *room_events = getenv("LANTERN_ROOM_EVENTS");
+	if (z_header.version == V3 && room_events && strcmp(room_events, "1") == 0) {
+		unsigned int length = 0;
+		bool valid = terminator == ZC_RETURN;
+		while (length < 97 && buf[length]) {
+			if (buf[length] < 32 || buf[length] > 126) valid = FALSE;
+			length++;
+		}
+		if (length > 96) valid = FALSE;
+		flush_buffer();
+		fputs("\036LANTERN_INPUT_V1 ", stdout);
+		if (!valid) fputc('!', stdout);
+		else for (unsigned int index = 0; index < length; index++)
+			fprintf(stdout, "%02x", (unsigned)buf[index]);
+		fputs("\037\n", stdout);
+		fflush(stdout);
+	}
