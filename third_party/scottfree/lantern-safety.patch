+static int ActionParameterCount=0;
+
+static int NextParam(int param[5], int *position, int maximum, const char *kind)
+{
+	if(*position < 0 || *position >= ActionParameterCount)
+		Fatal("Invalid database(action has too few parameters)");
+	int value=param[(*position)++];
+	if(value < 0)
+		Fatal("Invalid database(action has too few parameters)");
+	if(value > maximum)
+	{
+		char message[128];
+		snprintf(message,sizeof(message),"Invalid database(%s parameter out of range)",kind);
+		Fatal(message);
+	}
+	return value;
+}
